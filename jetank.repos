# vcstool manifest for the JeTank workspace.
#
# `jetank_ros_main` is the seed package: you already cloned it, so it does
# not list itself here. `install.sh` feeds this file to `vcs import` to
# clone the nine sibling packages into <ws>/src/.
#
# All siblings are pinned to `main` so a fresh clone installs the latest
# released state of every package. Switch to tags here when a coordinated
# release workflow lands (see the one-clone-install plan, Phase: follow-ups).
#
# NOTE: jetank_manipulation (kvgork/jetank_manipulation) is a new repo created
# in Phase B of the arm-moveit-grasp plan. The GitHub remote does not yet exist
# at time of writing — push the local src/jetank_manipulation repo and create it.
repositories:
  jetank_description:
    type: git
    url: git@github.com:kvgork/jetank_description.git
    version: main
  jetank_detection:
    type: git
    url: git@github.com:kvgork/jetank_detection.git
    version: main
  jetank_manipulation:
    type: git
    url: git@github.com:kvgork/jetank_manipulation.git
    version: main
  jetank_motor_control:
    type: git
    url: git@github.com:kvgork/jetank_motor_control.git
    version: main
  jetank_moveit_config:
    type: git
    url: git@github.com:kvgork/jetank_moveit_config.git
    version: main
  jetank_navigation:
    type: git
    url: git@github.com:kvgork/jetank_navigation.git
    version: main
  jetank_perception:
    type: git
    url: git@github.com:kvgork/jetank_perception.git
    version: main
  jetank_simulation:
    type: git
    url: git@github.com:kvgork/jetank_simulation.git
    version: main
  jetank_web_control:
    type: git
    url: git@github.com:kvgork/jetank_web_control.git
    version: main
  # NOTE: GitHub repo name is 'jetank_misson' (typo); local package + dir are
  # 'jetank_mission'. Rename the repo to jetank_mission and fix this url when convenient.
  jetank_mission:
    type: git
    url: git@github.com:kvgork/jetank_misson.git
    version: main
