<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="jetank_house">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- GUI -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 -9 8 0 0.7 1.5708</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 7</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 7</size></plane></geometry>
          <material>
            <ambient>0.55 0.52 0.48 1</ambient>
            <diffuse>0.55 0.52 0.48 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      House layout (6 m x 5 m footprint, walls 0.5 m tall, 0.1 m thick):

        +-------------------+---------+   y=+2.5
        |                   |  BED    |
        |                   | (top-R) |
        |     LIVING        +----.----+   y=0  (door near east wall: x 2.3..3)
        |     (left room)   |  KITCHEN|
        |        [R]        | (bot-R) |
        +-------------------+---------+   y=-2.5
       x=-3      door y±0.4 x=1.0     x=3

      Robot spawn [R] = (0,0), open living room. Doorways:
        - living <-> right side: gap in the x=1.0 divider, y in [-0.4, 0.4]
        - bedroom <-> kitchen:   gap in the y=0 divider, x in [2.3, 3.0]
    -->

    <!-- Outer walls -->
    <model name="wall_north"><static>true</static><link name="l">
      <pose>0 2.5 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>6.0 0.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
    </link></model>

    <model name="wall_south"><static>true</static><link name="l">
      <pose>0 -2.5 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>6.0 0.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
    </link></model>

    <model name="wall_east"><static>true</static><link name="l">
      <pose>3.0 0 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
    </link></model>

    <model name="wall_west"><static>true</static><link name="l">
      <pose>-3.0 0 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
    </link></model>

    <!-- Vertical divider at x=1.0 (doorway y in [-0.4, 0.4]) -->
    <model name="div_v_lower"><static>true</static><link name="l">
      <pose>1.0 -1.45 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.1 2.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2.1 0.5</size></box></geometry>
        <material><ambient>0.8 0.78 0.75 1</ambient><diffuse>0.8 0.78 0.75 1</diffuse></material></visual>
    </link></model>

    <model name="div_v_upper"><static>true</static><link name="l">
      <pose>1.0 1.45 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.1 2.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2.1 0.5</size></box></geometry>
        <material><ambient>0.8 0.78 0.75 1</ambient><diffuse>0.8 0.78 0.75 1</diffuse></material></visual>
    </link></model>

    <!-- Horizontal divider on the right (y=0, x 1.0..2.3; doorway x 2.3..3.0) -->
    <model name="div_h"><static>true</static><link name="l">
      <pose>1.65 0 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>1.3 0.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.3 0.1 0.5</size></box></geometry>
        <material><ambient>0.8 0.78 0.75 1</ambient><diffuse>0.8 0.78 0.75 1</diffuse></material></visual>
    </link></model>

    <!-- Furniture (kept clear of the (0,0) spawn) -->
    <model name="table"><static>true</static><link name="l">
      <pose>-2.0 1.5 0.2 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.7 0.5 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.7 0.5 0.4</size></box></geometry>
        <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
    </link></model>

    <model name="sofa"><static>true</static><link name="l">
      <pose>-2.5 -1.4 0.2 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.5 1.2 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 1.2 0.4</size></box></geometry>
        <material><ambient>0.20 0.35 0.5 1</ambient><diffuse>0.20 0.35 0.5 1</diffuse></material></visual>
    </link></model>

    <model name="bed"><static>true</static><link name="l">
      <pose>2.4 1.7 0.15 0 0 0</pose>
      <collision name="c"><geometry><box><size>1.0 0.8 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.0 0.8 0.3</size></box></geometry>
        <material><ambient>0.5 0.2 0.25 1</ambient><diffuse>0.5 0.2 0.25 1</diffuse></material></visual>
    </link></model>

    <model name="counter"><static>true</static><link name="l">
      <pose>2.6 -1.9 0.25 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.6 1.0 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 1.0 0.5</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
    </link></model>

  </world>
</sdf>
