<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetank_ros_main</name>
  <version>0.0.0</version>
  <description>Main integration package for JeTank AI robot platform</description>
  <maintainer email="gorkom.projects@gmail.com">koen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>

  <!-- Used by scripts/test_drive.py, scripts/test_cameras.py (console_scripts
       entry points) and topics.py (config/topics.yaml contract parser). -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Launch system dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_yaml</exec_depend>

  <!-- JeTank package dependencies. This is an ament_python package with no
       build step against these siblings (only their launch files, share
       directories and executables are used at launch time), so exec_depend
       is correct here, not depend; depend would also force jetank_simulation
       (Gazebo/ros_gz) onto every hardware-only build of this package. -->
  <exec_depend>jetank_motor_control</exec_depend>
  <exec_depend>jetank_perception</exec_depend>
  <exec_depend>jetank_navigation</exec_depend>
  <exec_depend>jetank_description</exec_depend>
  <exec_depend>jetank_simulation</exec_depend>
  <exec_depend>jetank_moveit_config</exec_depend>
  <exec_depend>jetank_web_control</exec_depend>
  <!-- launch/mobile_grasp.launch.py, mobile_grasp_hw.launch.py, sim_demo.launch.py -->
  <exec_depend>jetank_manipulation</exec_depend>

  <!-- Sock detection (optional at launch time via detect:=true) -->
  <exec_depend>jetank_detection</exec_depend>

  <!-- ROS2 standard packages -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
